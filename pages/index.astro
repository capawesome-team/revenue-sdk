---
import { Code } from 'astro:components';
import PageLayout from 'blume/components/layout/PageLayout.astro';
import Icon from 'blume/components/Icon.astro';
import data from 'blume:data';

const { config } = data;

const features = [
  {
    icon: 'layers',
    title: 'One unified API',
    description: 'Products, checkouts, subscriptions, customers, and webhooks over five providers.',
  },
  {
    icon: 'feather',
    title: 'Zero dependencies',
    description: 'Just fetch and Web Crypto. Nothing to audit, nothing to bloat your bundle.',
  },
  {
    icon: 'cloud',
    title: 'Workers-ready',
    description: 'No node:* imports. Runs on Cloudflare Workers without nodejs_compat.',
  },
  {
    icon: 'activity',
    title: 'One status model',
    description: 'Seven statuses across all providers, with cancelAtPeriodEnd split out.',
  },
  {
    icon: 'webhook',
    title: 'Webhook verify & parse',
    description: 'Standalone helpers that take a Web-standard Request — no client needed.',
  },
  {
    icon: 'package',
    title: 'Tree-shakable subpaths',
    description: 'Each provider on its own import path, so unused providers never bundle.',
  },
  {
    icon: 'list-checks',
    title: 'Capability gating',
    description: 'Providers differ. Unsupported options throw instead of being silently dropped.',
  },
  {
    icon: 'flask-conical',
    title: 'In-memory testing provider',
    description: 'Exercise your billing integration without a sandbox account or a test card.',
  },
];

const providerTabs = [
  {
    id: 'polar',
    label: 'Polar',
    code: `import { createClient } from 'revenue-sdk';
import { polar } from 'revenue-sdk/polar';

const client = createClient({
  provider: polar({ accessToken: process.env.POLAR_ACCESS_TOKEN! }),
});

const [product] = (await client.products.list()).items;

const checkout = await client.checkouts.create({
  items: [{ product: product.prices[0].checkoutRef }],
  customerEmail: 'ada@example.com',
  successUrl: 'https://example.com/thanks',
});
console.log(checkout.url);`,
  },
  {
    id: 'lemon-squeezy',
    label: 'Lemon Squeezy',
    code: `import { createClient } from 'revenue-sdk';
import { lemonSqueezy } from 'revenue-sdk/lemon-squeezy';

const client = createClient({
  provider: lemonSqueezy({
    apiKey: process.env.LEMON_SQUEEZY_API_KEY!,
    storeId: process.env.LEMON_SQUEEZY_STORE_ID!,
  }),
});

// Same call, same shape — only the provider changed.
const [product] = (await client.products.list()).items;

const checkout = await client.checkouts.create({
  items: [{ product: product.prices[0].checkoutRef }],
  customerEmail: 'ada@example.com',
});`,
  },
  {
    id: 'stripe',
    label: 'Stripe',
    code: `import { createClient } from 'revenue-sdk';
import { stripe } from 'revenue-sdk/stripe';

const client = createClient({
  provider: stripe({ secretKey: process.env.STRIPE_SECRET_KEY! }),
});

const checkout = await client.checkouts.create({
  items: [{ product: 'price_123', quantity: 1 }],
  successUrl: 'https://example.com/thanks',
  metadata: { userId: 'user_123' },
});`,
  },
  {
    id: 'paddle',
    label: 'Paddle',
    code: `import { createClient } from 'revenue-sdk';
import { paddle } from 'revenue-sdk/paddle';

const client = createClient({
  provider: paddle({ apiKey: process.env.PADDLE_API_KEY! }),
});

// Paddle has no hosted checkout — open the
// transaction with Paddle.js on your own page.
const checkout = await client.checkouts.create({
  items: [{ product: 'pri_123', quantity: 1 }],
  customerEmail: 'ada@example.com',
});`,
  },
  {
    id: 'dodo-payments',
    label: 'Dodo Payments',
    code: `import { createClient } from 'revenue-sdk';
import { dodoPayments } from 'revenue-sdk/dodo-payments';

const client = createClient({
  provider: dodoPayments({
    apiKey: process.env.DODO_PAYMENTS_API_KEY!,
  }),
});

const [product] = (await client.products.list()).items;

const checkout = await client.checkouts.create({
  items: [{ product: product.prices[0].checkoutRef }],
  successUrl: 'https://example.com/thanks',
});`,
  },
];

const webhookCode = `import { parseWebhookEvent, verifyWebhook } from 'revenue-sdk/stripe';

export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const headers = request.headers;
    const body = await request.text();

    const valid = await verifyWebhook({ headers, body, secret: env.STRIPE_WEBHOOK_SECRET });
    if (!valid) return new Response('invalid signature', { status: 401 });

    const event = await parseWebhookEvent({ headers, body });
    if (await seen(event.idempotencyKey)) return new Response(null, { status: 204 });

    if (event.type === 'subscription.updated') {
      // A scheduled cancellation arrives here, not as subscription.canceled.
      console.log(event.subscription.status, event.subscription.cancelAtPeriodEnd);
    }
    return new Response(null, { status: 204 });
  },
};`;

const statusCode = `// canceled is terminal. A scheduled cancellation keeps the status
// and sets cancelAtPeriodEnd — the same on all five providers.
const entitled = subscription.status === 'active' || subscription.status === 'trialing';

if (entitled && subscription.cancelAtPeriodEnd) {
  banner(\`Your plan ends on \${subscription.endsAt?.toLocaleDateString()}.\`);
}`;

const switchDiff = ` import { createClient } from 'revenue-sdk';
-import { polar } from 'revenue-sdk/polar';
+import { stripe } from 'revenue-sdk/stripe';

 const client = createClient({
-  provider: polar({ accessToken: process.env.POLAR_ACCESS_TOKEN! }),
+  provider: stripe({ secretKey: process.env.STRIPE_SECRET_KEY! }),
 });

 // Everything below stays exactly the same.
 const checkout = await client.checkouts.create({
   items: [{ product: price.checkoutRef }],
   successUrl: 'https://example.com/thanks',
 });`;

const specRows = [
  { term: 'Providers', detail: 'Stripe, Polar, Paddle, Lemon Squeezy, Dodo Payments' },
  { term: 'Runtime dependencies', detail: 'Zero — fetch and Web Crypto only' },
  { term: 'Runs on', detail: 'Node.js ≥ 22, Cloudflare Workers, Deno, Bun' },
  { term: 'Language', detail: 'TypeScript, fully typed, ESM only' },
  { term: 'License', detail: 'MIT — free for commercial use' },
];

const licenseCode = `// In the shipped app — no merchant credential required.
import { validateLicenseKey } from 'revenue-sdk/polar';

const { valid } = await validateLicenseKey({
  key: enteredKey,
  organizationId: 'YOUR_ORG_ID',
});

// On your server, with the merchant credential.
const licenseKey = await client.licenseKeys.get({ id: event.licenseKeyId });`;

const usageCode = `// Meter AI tokens, API calls, seats — anything countable.
await client.usage.report({
  customerId: 'cus_123',
  eventName: 'api_request',
  value: 25,
  idempotencyKey: 'req_8f3a2c', // safe to replay, never double-billed
});`;

const testingCode = `import { createClient } from 'revenue-sdk';
import { createInMemoryProvider } from 'revenue-sdk/testing';

const provider = createInMemoryProvider({
  products: [{ id: 'pro', name: 'Pro', prices: [{ amount: 2900, interval: 'month' }] }],
  customers: [{ id: 'cus-1', email: 'ada@example.com' }],
  subscriptions: [{ id: 'sub-1', customerId: 'cus-1', productId: 'pro', status: 'active' }],
});

// No account, no API keys, no test cards.
const client = createClient({ provider });`;

const capabilityRows = [
  { label: 'Provider-hosted checkout', values: [true, true, true, false, true] },
  { label: 'Checkout success URL', values: [true, true, true, false, true] },
  { label: 'Cancel immediately', values: [true, false, true, true, true] },
  { label: 'End trial early', values: [true, true, true, true, false] },
];

const docCards = [
  {
    icon: 'zap',
    title: 'Quickstart',
    description: 'From empty file to a verified webhook in minutes.',
    href: '/docs/quickstart',
  },
  {
    icon: 'activity',
    title: 'Subscription lifecycle',
    description: 'The unified status model and entitlement checks.',
    href: '/docs/concepts/subscription-lifecycle',
  },
  {
    icon: 'webhook',
    title: 'Webhooks',
    description: 'Verify, parse, dedupe, and fulfill end to end.',
    href: '/docs/concepts/webhooks',
  },
  {
    icon: 'table',
    title: 'Reference',
    description: 'Capability matrix, status mapping, events, error codes.',
    href: '/docs/reference/capability-matrix',
  },
];

const codeThemes = { light: 'github-light', dark: 'github-dark' } as const;

// Longer than the site description so the home page's meta description reads well in search results.
const pageDescription =
  'A unified, normalized TypeScript API over Polar, Lemon Squeezy, Stripe, Paddle, and Dodo Payments — zero dependencies, Workers-ready, fully typed.';

const faqs = [
  {
    question: 'Which billing providers does revenue-sdk support?',
    answer:
      'Stripe, Polar, Paddle, Lemon Squeezy, and Dodo Payments — each behind the same unified API, each on its own import subpath so unused providers never reach your bundle. You can also plug in any other provider with a custom adapter.',
    href: '/docs/guides/custom-provider',
    linkLabel: 'Write a custom adapter',
  },
  {
    question: 'Can I switch billing providers without a rewrite?',
    answer:
      'Yes. The provider factory is the only provider-specific line in your code — swap polar() for stripe() and every call, type, and webhook handler stays the same. Real differences are surfaced through a typed capability object instead of silent behavior changes.',
    href: '/docs/concepts/capabilities',
    linkLabel: 'See how capabilities work',
  },
  {
    question: 'Does revenue-sdk run on Cloudflare Workers?',
    answer:
      'Yes. revenue-sdk has zero runtime dependencies and no node:* imports, so it runs on Cloudflare Workers without the nodejs_compat flag — and on Node.js 22+, Deno, and Bun.',
    href: '/docs/guides/cloudflare-workers',
    linkLabel: 'Read the Workers guide',
  },
  {
    question: 'How does revenue-sdk handle webhooks?',
    answer:
      'Each provider subpath exports standalone verifyWebhook and parseWebhookEvent helpers that check the provider’s signature scheme and normalize events into one typed union — no client instance required.',
    href: '/docs/guides/webhook-handler',
    linkLabel: 'Build a webhook handler',
  },
  {
    question: 'How do I test a billing integration without a sandbox account?',
    answer:
      'Use the in-memory provider from revenue-sdk/testing: seed products, customers, and subscriptions, then run every client call against it in your test runner — no API keys, no fetch stubs, no test cards.',
    href: '/docs/providers/testing',
    linkLabel: 'Explore the testing provider',
  },
  {
    question: 'Is revenue-sdk free to use?',
    answer:
      'Yes. revenue-sdk is open source under the MIT license and free for commercial use; you pay only your billing provider’s regular fees.',
    href: 'https://github.com/capawesome-team/revenue-sdk',
    linkLabel: 'View the source on GitHub',
  },
  {
    question: 'Is revenue-sdk a payment processor?',
    answer:
      'No. revenue-sdk is an open-source TypeScript SDK that talks to your billing provider’s API — you keep your own Stripe, Polar, Paddle, Lemon Squeezy, or Dodo Payments account, and money always flows through the provider.',
    href: '/docs/quickstart',
    linkLabel: 'Start the quickstart',
  },
];

const siteUrl = config.site ? config.site.replace(/\/$/, '') : null;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'revenue-sdk',
      description: pageDescription,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Node.js 22+, Cloudflare Workers, Deno, Bun',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      license: 'https://opensource.org/license/MIT',
      ...(siteUrl ? { url: siteUrl, publisher: { '@id': `${siteUrl}#organization` } } : {}),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    ...(siteUrl
      ? [
          {
            '@id': `${siteUrl}#organization`,
            '@type': 'Organization',
            name: 'Capawesome',
            url: 'https://capawesome.io/',
          },
        ]
      : []),
  ],
};
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: 'revenue-sdk — the unified billing SDK for TypeScript',
    description: pageDescription,
  }}
>
  <main class="mx-auto w-full max-w-6xl px-6">
    <!-- Hero -->
    <section class="py-16 sm:py-24">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div>
          <span
            class="inline-flex items-center gap-1.5 rounded-blume border border-border px-3 py-1 text-xs font-medium text-muted-foreground"
          >
            <Icon name="layers" size={13} />
            Products · Checkouts · Subscriptions · Webhooks
          </span>
          <h1 class="mt-6 max-w-[30ch] text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
            The unified billing SDK for TypeScript
          </h1>
          <p class="mt-5 max-w-[48ch] text-lg text-pretty text-muted-foreground">
            revenue-sdk is an open-source TypeScript SDK that wraps Stripe, Polar, Paddle, Lemon
            Squeezy, and Dodo Payments in one normalized API — products, checkouts,
            subscriptions, customers, and webhooks included.
          </p>

          <div class="mt-8 flex max-w-md items-center">
            <div
              class="flex w-full items-center justify-between gap-2 rounded-blume border border-border bg-code-background px-4 py-3 text-left font-mono text-sm"
            >
              <span
                ><span class="select-none text-muted-foreground">$ </span>npm install revenue-sdk</span
              >
              <button
                type="button"
                class="copy-install inline-flex shrink-0 items-center text-muted-foreground transition-colors hover:text-foreground"
                data-command="npm install revenue-sdk"
                aria-label="Copy install command"
              >
                <span class="copy-idle"><Icon name="copy" size={15} /></span>
                <span class="copy-done hidden text-accent"><Icon name="check" size={15} /></span>
              </button>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="/docs"
              class="inline-flex items-center gap-1.5 rounded-blume bg-accent px-5 py-2.5 text-sm font-medium text-accent-foreground transition-opacity hover:opacity-90"
            >
              Read the docs
              <Icon name="arrow-right" size={15} />
            </a>
            <a
              href="/docs/quickstart"
              class="inline-flex items-center rounded-blume border border-border px-5 py-2.5 text-sm font-medium transition-colors hover:bg-muted"
            >
              Quickstart
            </a>
            <a
              href="https://github.com/capawesome-team/revenue-sdk"
              class="inline-flex items-center gap-1.5 rounded-blume border border-border px-5 py-2.5 text-sm font-medium transition-colors hover:bg-muted"
            >
              <Icon name="github" size={15} />
              GitHub
            </a>
          </div>
        </div>

        <div class="rounded-blume border border-border p-5 text-left">
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            revenue-sdk at a glance
          </p>
          <dl class="mt-2 divide-y divide-border">
            {
              specRows.map((row) => (
                <div class="py-3">
                  <dt class="text-xs text-muted-foreground">{row.term}</dt>
                  <dd class="mt-1 text-sm font-medium">{row.detail}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div
        class="mt-14 overflow-hidden rounded-blume border border-border bg-code-background text-left"
      >
        <div
          class="flex items-center gap-1 overflow-x-auto border-b border-border px-2 pt-2"
          role="tablist"
          aria-label="Provider"
        >
          {
            providerTabs.map((tab, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                aria-controls={`panel-${tab.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                class:list={[
                  'provider-tab -mb-px whitespace-nowrap rounded-t-blume border-b-2 px-3 py-2 text-xs font-medium transition-colors',
                  index === 0
                    ? 'border-accent text-foreground'
                    : 'border-transparent text-muted-foreground hover:text-foreground',
                ]}
              >
                {tab.label}
              </button>
            ))
          }
        </div>
        {
          providerTabs.map((tab, index) => (
            <div
              role="tabpanel"
              id={`panel-${tab.id}`}
              aria-labelledby={`tab-${tab.id}`}
              class:list={[
                'provider-panel overflow-x-auto p-5 text-sm',
                index === 0 ? '' : 'hidden',
              ]}
            >
              <Code code={tab.code} lang="ts" themes={codeThemes} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Provider switch -->
    <section class="py-8">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div>
          <h2 class="max-w-[40ch] text-2xl font-semibold tracking-tight">
            Switch billing providers in two lines
          </h2>
          <p class="mt-3 max-w-[56ch] text-sm text-muted-foreground lg:pr-8">
            The provider factory is the only provider-specific code in your integration. Swap it out
            and every call, every type, and every webhook handler keeps working — revenue-sdk
            normalizes what the providers spell differently.
          </p>
          <a
            href="/docs/concepts/capabilities"
            class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
          >
            See what changes when you switch
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
        <div
          class="overflow-x-auto rounded-blume border border-border bg-code-background p-5 text-left text-sm"
        >
          <Code code={switchDiff} lang="diff" themes={codeThemes} />
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="py-16">
      <h2 class="max-w-[40ch] text-2xl font-semibold tracking-tight">Why revenue-sdk?</h2>
      <p class="mt-3 max-w-[56ch] text-sm text-muted-foreground">
        Because billing providers agree on almost nothing. revenue-sdk gives you one set of models,
        statuses, errors, and events across all five — and tells you exactly where providers differ
        instead of papering over it.
      </p>
      <dl class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          features.map((feature) => (
            <div class="rounded-blume border border-border p-5">
              <span class="text-accent">
                <Icon name={feature.icon} size={18} />
              </span>
              <dt class="mt-3 text-sm font-semibold">{feature.title}</dt>
              <dd class="mt-2 text-sm text-muted-foreground">{feature.description}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Status model -->
    <section class="py-8">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div>
          <h2 class="max-w-[40ch] text-2xl font-semibold tracking-tight">
            One subscription status model
          </h2>
          <p class="mt-3 text-sm text-muted-foreground lg:pr-8">
            Every provider spells cancellation differently, and most overload one status to mean both
            “ended” and “still paid up until the period ends”. <code class="font-mono">revenue-sdk</code>
            normalizes all of it into seven statuses plus
            <code class="font-mono">cancelAtPeriodEnd</code>, so
            <code class="font-mono">canceled</code> always means terminal.
          </p>
          <a
            href="/docs/concepts/subscription-lifecycle"
            class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
          >
            Read the lifecycle guide
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
        <div
          class="overflow-x-auto rounded-blume border border-border bg-code-background p-5 text-left text-sm"
        >
          <Code code={statusCode} lang="ts" themes={codeThemes} />
        </div>
      </div>
    </section>

    <!-- Webhooks -->
    <section class="py-8">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div
          class="order-2 overflow-x-auto rounded-blume border border-border bg-code-background p-5 text-left text-sm lg:order-1"
        >
          <Code code={webhookCode} lang="ts" themes={codeThemes} />
        </div>
        <div class="order-1 lg:order-2">
          <h2 class="max-w-[40ch] text-2xl font-semibold tracking-tight">
            Webhooks without the ceremony
          </h2>
          <p class="mt-3 text-sm text-muted-foreground lg:pr-8">
            <code class="font-mono">verifyWebhook</code> and
            <code class="font-mono">parseWebhookEvent</code> are standalone helpers that take a
            Web-standard <code class="font-mono">Request</code> — no client needed. They know each
            provider's signature scheme, including the two that look identical and aren't.
          </p>
          <a
            href="/docs/concepts/webhooks"
            class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
          >
            Read the webhook guide
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </section>

    <!-- License keys -->
    <section class="py-8">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div>
          <h2 class="max-w-[40ch] text-2xl font-semibold tracking-tight">
            License keys without shipping your secret key
          </h2>
          <p class="mt-3 max-w-[56ch] text-sm text-muted-foreground lg:pr-8">
            Validate, activate, and deactivate license keys straight from your desktop or mobile
            app. The standalone helpers take no merchant credential, so your API key never leaves
            the server — supported on Polar, Lemon Squeezy, and Dodo Payments.
          </p>
          <a
            href="/docs/concepts/license-keys"
            class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
          >
            Read the license key guide
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
        <div
          class="overflow-x-auto rounded-blume border border-border bg-code-background p-5 text-left text-sm"
        >
          <Code code={licenseCode} lang="ts" themes={codeThemes} />
        </div>
      </div>
    </section>

    <!-- Usage-based billing -->
    <section class="py-8">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div
          class="order-2 overflow-x-auto rounded-blume border border-border bg-code-background p-5 text-left text-sm lg:order-1"
        >
          <Code code={usageCode} lang="ts" themes={codeThemes} />
        </div>
        <div class="order-1 lg:order-2">
          <h2 class="max-w-[40ch] text-2xl font-semibold tracking-tight">
            Usage-based billing in one call
          </h2>
          <p class="mt-3 max-w-[56ch] text-sm text-muted-foreground lg:pr-8">
            Report metered usage with one validated call. revenue-sdk never retries usage events on
            its own, so a flaky network cannot double-bill your customers — supported on Polar,
            Stripe, and Dodo Payments.
          </p>
          <a
            href="/docs/concepts/usage-based-billing"
            class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
          >
            Read the usage guide
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </section>

    <!-- Testing provider -->
    <section class="py-8">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div>
          <h2 class="max-w-[40ch] text-2xl font-semibold tracking-tight">
            Test billing flows without a sandbox
          </h2>
          <p class="mt-3 max-w-[56ch] text-sm text-muted-foreground lg:pr-8">
